# Local development env for Markflare.
#
# Copy this file to `.dev.vars` and fill in real values:
#   cp .env.example .dev.vars
#
# `.dev.vars` is gitignored and is read automatically by:
#   - Cloudflare Pages (in `wrangler pages dev`)
#   - the local Express backend (server/index.ts reads the same vars)
#
# In production these same three values go in the Cloudflare dashboard:
#   Project → Settings → Variables and secrets → Add (Encrypt type)
#   AUTH_USERNAME  → your username
#   AUTH_PASSWORD  → your password
#   AUTH_SECRET    → a long random string
#
# Generate a strong AUTH_SECRET with:
#   openssl rand -hex 32        # 64 hex chars
#
# Rotating AUTH_SECRET invalidates ALL bearer tokens previously issued.
# Use this if a token ever leaks into git history or to a third party.

AUTH_USERNAME=admin

AUTH_PASSWORD=replace-with-a-strong-password

AUTH_SECRET=replace-with-output-of-openssl-rand-hex-32
