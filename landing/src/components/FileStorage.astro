---
// The landing had nothing on R2, which is a third of the infrastructure and the
// reason the 25 MB upload cap exists. This section states the split, the two
// steps to set it up, and the one mistake that exposes your files.
import Icon from './Icon.astro';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';

const STEPS = isEs
  ? [
      {
        n: '1',
        title: 'Crear el bucket',
        detail: 'R2 → Overview → Create bucket. Nombre: markflare-files. Déjalo privado.',
        code: 'markflare-files',
      },
      {
        n: '2',
        title: 'Vincularlo al proyecto',
        detail:
          'Workers & Pages → tu proyecto → Settings → Functions → R2 bucket bindings → Add. El nombre de la variable tiene que ser exactamente BUCKET.',
        code: 'BUCKET → markflare-files',
      },
    ]
  : [
      {
        n: '1',
        title: 'Create the bucket',
        detail: 'R2 → Overview → Create bucket. Name: markflare-files. Keep it private.',
        code: 'markflare-files',
      },
      {
        n: '2',
        title: 'Bind it to your project',
        detail:
          'Workers & Pages → your project → Settings → Functions → R2 bucket bindings → Add. The variable name has to be exactly BUCKET.',
        code: 'BUCKET → markflare-files',
      },
    ];
---

<section id="storage" class="storage-section">
  <div class="container">
    <div class="section-header">
      <span class="badge badge-accent">
        {isEs ? 'ARCHIVOS' : 'FILE STORAGE'}
      </span>
      <h2 class="section-title">
        {isEs ? 'Tus imágenes no viven en la base de datos' : 'Your images do not live in the database'}
      </h2>
      <p class="section-desc">
        {isEs
          ? 'Las notas van a D1. Los archivos van a R2, que es almacenamiento de objetos. Esa separación es la razón por la que puedes subir algo de 25 MB en vez de uno y medio.'
          : 'Notes go to D1. Files go to R2, which is object storage. That split is why you can upload 25 MB instead of one and a half.'}
      </p>
    </div>

    <!-- The whole argument in one comparison. -->
    <div class="limit-compare">
      <div class="limit-col limit-col--muted">
        <span class="limit-label">{isEs ? 'En D1, como base64' : 'In D1, as base64'}</span>
        <span class="limit-value">1,5<small>MB</small></span>
        <p class="limit-note">
          {isEs
            ? 'Una fila de D1 tope 2 MB, y el base64 le suma otro 33%. Ese es el techo real por archivo.'
            : 'A D1 row tops out at 2 MB, and base64 adds another 33% on top. That is the real per-file ceiling.'}
        </p>
      </div>

      <div class="limit-col limit-col--strong">
        <span class="limit-label">{isEs ? 'En R2' : 'In R2'}</span>
        <span class="limit-value">25<small>MB</small></span>
        <p class="limit-note">
          {isEs
            ? 'Los bytes van al bucket, la metadata a D1. El archivo no toca la base de datos en ningún momento.'
            : 'The bytes go to the bucket, the metadata to D1. The file never touches the database.'}
        </p>
      </div>
    </div>

    <div class="storage-split">
      <p class="split-note">
        {isEs
          ? 'La tabla files guarda solo el nombre, el tipo MIME y el tamaño. Nada más.'
          : 'The files table stores the name, MIME type and size. Nothing else.'}
      </p>
    </div>

    <!-- The two setup steps -->
    <div class="steps-grid">
      {
        STEPS.map((s) => (
          <div class="setup-step">
            <span class="step-num">{s.n}</span>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-detail">{s.detail}</p>
            <code class="step-code">{s.code}</code>
          </div>
        ))
      }
    </div>

    <div class="storage-notes">
      <div class="note-item">
        <Icon name="shield" size={18} class="note-icon" />
        <div>
          <strong>{isEs ? 'Bucket privado, siempre' : 'Private bucket, always'}</strong>
          <p>
            {isEs
              ? 'No actives el dominio público r2.dev. Los archivos se sirven desde /api/files/:id a través del Worker; un bucket público los expondría directo.'
              : 'Do not turn on the public r2.dev domain. Files are served from /api/files/:id through the Worker; a public bucket would expose them directly.'}
          </p>
        </div>
      </div>

      <div class="note-item">
        <Icon name="lock" size={18} class="note-icon" />
        <div>
          <strong>{isEs ? 'Sin binding no hay subidas' : 'No binding, no uploads'}</strong>
          <p>
            {isEs
              ? 'Sin el binding BUCKET la API responde 503. A propósito no hay respaldo que escriba en D1: preferimos un fallo visible a una base que se llena sola.'
              : 'Without the BUCKET binding the API returns 503. On purpose there is no fallback that writes into D1: a loud failure beats a database that quietly fills up.'}
          </p>
        </div>
      </div>

      <div class="note-item">
        <Icon name="download" size={18} class="note-icon" />
        <div>
          <strong>{isEs ? 'Cuesta cero a esta escala' : 'Free at this scale'}</strong>
          <p>
            {isEs
              ? 'El free tier da 10 GB de almacenamiento, 1M escrituras y 10M lecturas al mes, sin cargo por ancho de banda. Pasado ese punto, $0,015/GB-mes.'
              : 'The free tier covers 10 GB of storage, 1M writes and 10M reads a month, with no bandwidth charge. Past that, $0.015/GB-month.'}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .storage-section {
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }

  .limit-compare {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: var(--border-color);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    overflow: hidden;
  }

  .limit-col {
    padding: 28px 26px;
    background-color: var(--bg-primary);
    display: flex;
    flex-direction: column;
  }

  .limit-col--strong {
    background-color: var(--bg-tertiary);
  }

  .limit-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .limit-value {
    font-size: 52px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-top: 10px;
    color: var(--text-tertiary);
  }

  .limit-value small {
    font-size: 22px;
    font-weight: 500;
    margin-left: 4px;
    color: var(--text-tertiary);
  }

  .limit-col--strong .limit-label,
  .limit-col--strong .limit-value,
  .limit-col--strong .limit-value small {
    color: var(--text-primary);
  }

  .limit-note {
    font-size: 13.5px;
    line-height: 1.6;
    margin-top: 10px;
    max-width: 42ch;
  }

  .storage-split {
    margin-top: 20px;
  }

  .split-note {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-secondary);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: 40px;
  }

  .setup-step {
    padding: 22px 22px 24px;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    background-color: var(--bg-primary);
  }

  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    margin-bottom: 12px;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .step-title {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--text-primary);
  }

  .step-detail {
    font-size: 13.5px;
    line-height: 1.6;
  }

  .step-code {
    display: inline-block;
    margin-top: 12px;
    padding: 5px 9px;
    background-color: var(--bg-code);
    border: 1px solid var(--border-subtle);
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-primary);
  }

  .storage-notes {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .note-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .note-icon {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--text-tertiary);
  }

  .note-item strong {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 3px;
  }

  .note-item p {
    font-size: 13.5px;
    line-height: 1.6;
    max-width: 68ch;
  }

  @media (min-width: 800px) {
    .limit-compare {
      grid-template-columns: 1fr 1fr;
    }

    .steps-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
